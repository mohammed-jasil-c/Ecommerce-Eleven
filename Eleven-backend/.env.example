SECRET_KEY=replace-with-a-strong-random-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com,ec2-xx-xx-xx-xx.compute.amazonaws.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com,https://dxxxxxxxx.cloudfront.net

DB_NAME=eleven
DB_USER=eleven_app
DB_PASSWORD=replace-with-rds-password
